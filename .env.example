# ==============================================================================
# BASETRACK APP - Variables de Entorno de Despliegue en Servidor
# ==============================================================================

# Puerto expuesto en la máquina anfitriona (3001, 80 o 8080)
HOST_PORT=3001

# Secreto criptográfico para firma de tokens JWT (generar uno seguro para faena)
# Generar con: openssl rand -hex 48   (obligatorio: docker compose no arranca sin él)
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (vacío = cualquier origen, sin credenciales)
# Ejemplo: https://basetrack-app.vercel.app,http://192.168.1.50:3001
CORS_ORIGINS=

# Zona horaria del servidor (UTC-5 para Perú / faenas andinas)
TZ=America/Lima
