{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "BASETRACK - Monitoreo Operacional de Planta",
  "short_name": "BASETRACK",
  "description": "Sistema de monitoreo SCADA, bitácora y relevo de guardia para operaciones mineras e industriales",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "lang": "es",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard Principal",
      "short_name": "Dashboard",
      "description": "Ver indicadores clave y telemetría general",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bombas Slurry",
      "short_name": "Bombas",
      "description": "Reporte y telemetría de bombas y sentinas",
      "url": "/pumps",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Batería de Ciclones",
      "short_name": "Ciclones",
      "description": "Planilla metalúrgica y balance de mallas",
      "url": "/cyclones",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Cambio de Guardia",
      "short_name": "Guardia",
      "description": "Relevo operacional y bitácora de turno",
      "url": "/shift-handover",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mi Perfil / Cuenta",
      "short_name": "Perfil",
      "description": "Configurar credenciales, nombre y avatar",
      "url": "/profile",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
